# The V3 multilingual checkpoint is the default; v2 is also supported.
CHATTERBOX_MULTILINGUAL_T3_MODEL=v3
VOICE_STUDIO_MODEL_REVISION=5bb1f6ee58e50c3b8d408bc82a6d3740c2db6e18
# multilingual is the verified default on 8 GB Apple Silicon; dedicated is experimental and heavier.
VOICE_STUDIO_HINDI_MODEL=multilingual
VOICE_STUDIO_HINDI_MODEL_REVISION=82ca71273cc2a9ab19efdf8315f865c1a5af0ee7

# auto, mps, cpu, or cuda. On Apple Silicon, auto selects MPS when available.
VOICE_STUDIO_DEVICE=auto

# Local Gradio server settings.
VOICE_STUDIO_HOST=127.0.0.1
VOICE_STUDIO_PORT=7860
# Generated WAVs and reproducibility JSON are kept here, relative to the working directory.
VOICE_STUDIO_OUTPUT_DIR=outputs
# Bound CPU parallelism on small machines. MPS may still use substantial resources.
VOICE_STUDIO_THREADS=4
PYTORCH_ENABLE_MPS_FALLBACK=1
